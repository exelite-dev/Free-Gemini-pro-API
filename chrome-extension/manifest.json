{
  "manifest_version": 3,
  "name": "OmniBridge Auto-Sync",
  "version": "1.1.0",
  "description": "همگام‌سازی خودکار و پس‌زمینه کوکی‌های Google Gemini و توکن‌های ChatGPT به سرور OmniBridge جهت جلوگیری ۱۰۰٪ از سوختن و انقضای سشن‌ها.",
  "permissions": [
    "cookies",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://*.google.com/*",
    "https://gemini.google.com/*",
    "https://chatgpt.com/*",
    "https://*.chatgpt.com/*",
    "https://*.onrender.com/*",
    "http://localhost:*/*",
    "http://127.0.0.1:*/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "OmniBridge Auto-Sync",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
