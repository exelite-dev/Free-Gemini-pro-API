# ─────────────────────────────────────────────
# OmniBridge Environment Configuration
# Copy this file to .env and fill in values.
# ─────────────────────────────────────────────

# ── Admin ─────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
ADMIN_SECRET_KEY=supersecretkey-change-in-production

# ── Provider Toggles ─────────────────────────
GEMINI_ENABLED=true

# ── Gemini ────────────────────────────────────
# Add accounts via the admin UI (recommended) or here as JSON list
# GEMINI_ACCOUNTS=[{"psid": "...", "psidts": "...", "label": "account1"}]

# ── API Keys ──────────────────────────────────
# Permanent API keys to load on startup (comma separated or JSON list)
# OMNIBRIDGE_API_KEYS=sk-omni-mykey1,sk-omni-mykey2

# ── Server ────────────────────────────────────
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info

# ── Database ──────────────────────────────────
DATABASE_PATH=./data/omnibridge.db

# ── Config File ───────────────────────────────
CONFIG_FILE=./config.yaml
